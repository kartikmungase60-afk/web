# ========================================================
# 🥧 BATTLEPIE NETWORK CONFIGURATION
# ========================================================

PORT=3000
NODE_ENV=development

# --------------------------------------------------------
# 🎮 MINECRAFT SERVER CONNECTION
# --------------------------------------------------------
MC_HOST=play.battlepie.net
MC_PORT=25565
MC_BEDROCK_PORT=19132

# Shared secret key for in-game /link plugin verification
SERVER_SECRET=battlepie_secret_token_123

# Minecraft RCON (Remote Console) for perks
RCON_ENABLED=false
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=battlepie_rcon_secret

# --------------------------------------------------------
# 💬 DISCORD OAUTH2 AUTHENTICATION SETUP
# --------------------------------------------------------
# 1. Go to https://discord.com/developers/applications
# 2. Create Application -> OAuth2
# 3. Add Redirect: http://localhost:3000/auth/discord/callback
# 4. Fill in Client ID and Client Secret below:
DISCORD_CLIENT_ID=1512866835899613314
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
DISCORD_INVITE=battlepie
