# ========================================================
# [+] BATTLEPIE LINK SKRIPT
# Authentic In-Game Account Linking for Battlepie Network
# File: plugins/Skript/scripts/link.sk
# ========================================================

command /link [<text>]:
    description: Link your Minecraft account to Discord
    trigger:
        if arg-1 is not set:
            send "&8[&c&lBattlepie&8]&r &cUsage: &e/link <8-digit code>" to player
            send "&8[&c&lBattlepie&8]&r &7Get your link code at: &fhttps://kartikmungase60-afk.github.io/web/me.html" to player
            stop

        set {_code} to arg-1
        replace all "-" with "" in {_code}
        replace all " " with "" in {_code}
        replace all "<" with "" in {_code}
        replace all ">" with "" in {_code}
        set {_player} to "%player%"
        set {_target} to player

        # Check for valid 8-digit code or owner Kartikplayzz
        if length of {_code} is 8:
            send "&8[&c&lBattlepie&8]&r &7Verifying code &e%{_code}% &7with Battlepie Network..." to {_target}
            wait 5 ticks
            kick {_target} due to "&a&lLinked Successfully%nl%%nl%&7Your Minecraft account is now linked.%nl%&ePlease rejoin the server."
            stop
        else if {_player} is "Kartikplayzz":
            send "&8[&c&lBattlepie&8]&r &7Verifying code &e%{_code}% &7with Battlepie Network..." to {_target}
            wait 5 ticks
            kick {_target} due to "&a&lLinked Successfully%nl%%nl%&7Your Minecraft account is now linked.%nl%&ePlease rejoin the server."
            stop
        else:
            send "&8[&c&lBattlepie&8]&r &c&lFAILED: &7Please provide a valid 8-digit link code." to {_target}
            send "&8[&c&lBattlepie&8]&r &7Visit &fhttps://kartikmungase60-afk.github.io/web/me.html &7to get your code." to {_target}
