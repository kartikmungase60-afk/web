# ========================================================
#  🍊 MINE ORANGE NETWORK - IN-GAME ACCOUNT LINKING SKRIPT
#  File: plugins/Skript/scripts/mineorange_link.sk
# ========================================================
#
#  How to install:
#  1. Place this file into: plugins/Skript/scripts/mineorange_link.sk
#  2. Run command in-game: /sk reload mineorange_link
#  3. Players get code on: https://mineorange.fun/me
#  4. Players type: /link <8-digit code>
# ========================================================

on script load:
    if {mineorange::wiped_clean_v2} is not set:
        delete {mineorange::linked::*}
        set {mineorange::wiped_clean_v2} to true

command /link [<text>]:
    description: Link your Minecraft account to Mine Orange Discord
    usage: /link <8-digit code>
    aliases: /mclink, /discordlink, /molink
    trigger:
        if arg-1 is not set:
            if {mineorange::linked::%player's uuid%} is set:
                send "&8[&6&lMine Orange&8]&r &a✔ You are ALREADY linked to Mine Orange Web!" to player
                send "&8[&6&lMine Orange&8]&r &7View your profile and claim perks at: &fhttps://mineorange.fun/me" to player
                stop
            send "&8[&6&lMine Orange&8]&r &cUsage: &e/link <8-digit code>" to player
            send "&8[&6&lMine Orange&8]&r &7Get your link code at: &fhttps://mineorange.fun/me" to player
            stop

        if arg-1 is "status":
            if {mineorange::linked::%player's uuid%} is set:
                send "&8[&6&lMine Orange&8]&r &a✔ Linked! Dashboard: &fhttps://mineorange.fun/me" to player
            else:
                send "&8[&6&lMine Orange&8]&r &c✖ Not linked. Visit &fhttps://mineorange.fun/me &cfor your code." to player
            stop

        if arg-1 is "unlink":
            delete {mineorange::linked::%player's uuid%}
            send "&8[&6&lMine Orange&8]&r &eIn-game link status reset. To re-link, visit &fhttps://mineorange.fun/me" to player
            stop

        if arg-1 is "resetall" or "clearall" or "wipe":
            delete {mineorange::linked::*}
            send "&8[&6&lMine Orange&8]&r &a✔ All in-game player link records have been completely reset!" to player
            stop

        set {_code} to arg-1
        replace all "-" with "" in {_code}
        replace all " " with "" in {_code}
        replace all "<" with "" in {_code}
        replace all ">" with "" in {_code}
        if length of {_code} is not 8:
            send "&8[&6&lMine Orange&8]&r &c&lFAILED: &7Please provide a valid 8-digit link code." to player
            send "&8[&6&lMine Orange&8]&r &7Visit &fhttps://mineorange.fun/me &7to get your code." to player
            stop

        # Forward directly to MineOrangeLink Java plugin which contacts https://mineorange.fun/api/auth/link/ingame
        execute player command "mineorangelink:link %{_code}%"
        set {mineorange::linked::%player's uuid%} to true
